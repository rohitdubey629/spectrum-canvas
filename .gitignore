# Composer-managed dependencies
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/recipes/*
!/recipes/README.txt

# Drupal scaffold files (regenerated by composer)
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/web/.ht.router.php
/web/.htaccess
/web/INSTALL.txt
/web/README.md
/web/autoload.php
/web/autoload_runtime.php
/web/example.gitignore
/web/index.php
/web/robots.txt
/web/update.php
/web/web.config
/web/sites/README.txt
/web/sites/development.services.yml
/web/sites/example.settings.local.php
/web/sites/example.sites.php
/web/sites/default/default.services.yml
/web/sites/default/default.settings.php
/web/modules/README.txt
/web/profiles/README.txt
/web/themes/README.txt

# Site-specific settings and user files
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml
/web/sites/*/files/
/web/sites/*/private/
/web/sites/simpletest/

# Front-end build artifacts
node_modules/

# Environment and local tooling
.env
.lando.local.yml
*.sql
*.sql.gz

# OS / IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
