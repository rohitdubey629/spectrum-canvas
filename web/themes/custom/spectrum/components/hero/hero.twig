{#
/**
 * @file
 * Hero component.
 */
#}
{% set size = size ?? 'large' %}
{% set alignment = alignment ?? 'left' %}
<section{{ attributes.addClass('sp-hero', 'sp-hero--' ~ size, 'sp-hero--' ~ alignment) }}>
  {% if image and image.src %}
    {# Above the fold: load eagerly. #}
    {% include 'canvas:image' with image|merge({
      class: 'sp-hero__image',
      loading: 'eager',
      sizes: '100vw',
    }) only %}
  {% endif %}
  <div class="sp-hero__inner container">
    <div class="sp-hero__content">
      {% if eyebrow %}
        <p class="sp-hero__eyebrow">{{ eyebrow }}</p>
      {% endif %}
      <h1 class="sp-hero__heading">{{ heading }}</h1>
      {% if date %}
        <p class="sp-hero__date"><time datetime="{{ date }}">{{ date|date('j F Y') }}</time></p>
      {% endif %}
      {% if text %}
        <p class="sp-hero__text">{{ text|nl2br }}</p>
      {% endif %}
      {% if (button_text and button_url) or (secondary_button_text and secondary_button_url) %}
        <div class="sp-hero__buttons">
          {% if button_text and button_url %}
            <a class="button" href="{{ button_url }}">{{ button_text }}</a>
          {% endif %}
          {% if secondary_button_text and secondary_button_url %}
            <a class="button button--outline sp-hero__button-secondary" href="{{ secondary_button_url }}">{{ secondary_button_text }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
